# --- Databáze (Supabase Postgres) -------------------------------------------
# Supabase → Connect → Session pooler (port 5432). NE transaction pooler (6543):
# na ten postgres.js zamrzá (viz lib/db/client.ts). NE přímá adresa db.…:
# ta je jen přes IPv6 a Vercel se k ní nepřipojí. Region vezmi z Connect.
DATABASE_URL="postgresql://postgres.<ref>:<heslo>@aws-1-<region>.pooler.supabase.com:5432/postgres"
# Pro drizzle-kit push. Stejná adresa jako DATABASE_URL.
DIRECT_URL="postgresql://postgres.<ref>:<heslo>@aws-1-<region>.pooler.supabase.com:5432/postgres"

# --- Admin ------------------------------------------------------------------
# HTTP Basic heslo pro /admin (zadání seznamu lidí, reset hry).
# Když není nastavené, /admin je v produkci zavřený úplně.
ADMIN_PASSWORD="vanoce2026"
